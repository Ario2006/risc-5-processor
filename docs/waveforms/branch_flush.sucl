# ABOUTME: Annotated Surfer capture view for branch_flush.
# ABOUTME: Load with build/hazard_demo.vcd after make demo.
divider_add
item_focus a
item_rename branch_flush
variable_add tb_cpu.clk
variable_add tb_cpu.dut.if_pc
variable_add tb_cpu.dut.id_pc
variable_add tb_cpu.dut.id_valid
variable_add tb_cpu.dut.ex_pc
variable_add tb_cpu.dut.ex_valid
variable_add tb_cpu.dut.flush
variable_add tb_cpu.dut.fwd_a
variable_add tb_cpu.dut.fwd_b
theme_select light+
zoom_fit
zoom_in
zoom_in
goto_time 92500
marker_set 85ns_flush 85000
marker_set 95ns_redirect 95000
item_unfocus
